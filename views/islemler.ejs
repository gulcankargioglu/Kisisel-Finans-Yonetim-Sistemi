<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>İşlemler - Finova</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { background:#0f172a; color:white; font-family:Arial; overflow-x:hidden; }
        
       
        .sidebar { width:260px; height:100vh; background:#111827; position:fixed; padding:30px 20px; border-right:1px solid rgba(255,255,255,0.05); }
        .logo { font-size:34px; font-weight:bold; margin-bottom:50px; }
        .menu-item { display:flex; align-items:center; gap:12px; text-decoration:none; color:#cbd5e1; padding:16px; border-radius:16px; margin-bottom:10px; transition:0.3s; }
        .menu-item:hover { background:#1e293b; color:white; }
        .active-menu { background:#10b981; color:white; }
        
        
        .main { margin-left:260px; padding:35px; }

       
        .form-box { background:#111827; border-radius:28px; padding:32px; margin-bottom:35px; box-shadow:0 0 30px rgba(0,0,0,0.2); }
        .form-box h4 { margin-bottom:25px; font-size:28px; font-weight:bold; }
        .form-control, .form-select { background:#1e293b !important; border:none !important; color:white !important; padding:14px; border-radius:14px; }
        .form-control::placeholder { color:#94a3b8 !important; }

       
        .submit-btn { background:#10b981; border:none; width:100%; padding:14px; border-radius:14px; color:white; font-weight:bold; transition:0.3s; cursor:pointer; }
        .submit-btn:hover { background:#059669; }
        .action-btn { background: none; border: none; color: #94a3b8; font-size: 18px; transition: 0.3s; padding: 5px; text-decoration: none; }
        .action-btn:hover { color: white; }
        .delete-btn:hover { color: #ef4444 !important; }

       
        .table-box { background:#111827; border-radius:30px; padding:32px; box-shadow:0 0 40px rgba(0,0,0,0.25); }
        .custom-table { width:100%; border-collapse:separate; border-spacing:0 12px; }
        .custom-table thead th { color:#94a3b8; font-size:14px; padding:0 18px 10px 18px; }
        .custom-table tbody tr { background:#1e293b; transition:0.3s; }
        .custom-table tbody tr:hover { transform:scale(1.005); background:#243041; }
        .custom-table td { padding:22px 18px; color:white; vertical-align:middle; }
        .custom-table td:first-child { border-top-left-radius: 20px; border-bottom-left-radius: 20px; }
        .custom-table td:last-child { border-top-right-radius: 20px; border-bottom-right-radius: 20px; }

        
        .kategori-badge { display:inline-block; background:#0f172a; color:#cbd5e1; padding:10px 16px; border-radius:14px; font-size:14px; }
        .tur { padding:10px 16px; border-radius:14px; font-size:14px; font-weight:600; }
        .gelir { background:rgba(16,185,129,0.12); color:#10b981; }
        .gider { background:rgba(239,68,68,0.12); color:#ef4444; }
        
        .filter-btn { border:none; color:#94a3b8; padding:8px 16px; border-radius:10px; text-decoration:none; transition:0.3s; font-size: 14px; }
        .filter-btn.active { background:#10b981; color:white; }

        
        .modal-content { background:#111827; color:white; border-radius:28px; border: 1px solid rgba(255,255,255,0.08); }

        
input[type="date"]::-webkit-calendar-picker-indicator {
    filter: invert(1);
    cursor: pointer;
    opacity: 0.8;
}
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="logo">Finova</div>
        <a href="/dashboard" class="menu-item"><i class="bi bi-grid"></i> Dashboard</a>
        <a href="/islemler" class="menu-item active-menu"><i class="bi bi-cash-stack"></i> İşlemler</a>
        <a href="/analizler" class="menu-item"><i class="bi bi-pie-chart"></i> Analizler</a>
        <a href="/butceler" class="menu-item"><i class="bi bi-bullseye"></i> Bütçeler</a>
    </div>

    <div class="main">
        
        <div class="form-box">
            <h4>Yeni İşlem Ekle</h4>
            <form action="/ekle" method="POST">
                <div class="row g-3">
                    <div class="col-lg-2" style="width:15%">
                        <input type="number" step="0.01" name="tutar" placeholder="Tutar" class="form-control" required>
                    </div>
                    <div class="col-lg-2" style="width:11%">
                        <select name="tur" class="form-select" required>
                            <option value="" selected disabled>▼ Tür</option>
                            <option value="gelir">Gelir</option>
                            <option value="gider">Gider</option>
                        </select>
                    </div>
                    <div class="col-lg-2" style="width:15%">
                        <select name="hesap_id" class="form-select" required>
                            <option value="" selected disabled>▼ Hesap Seçin</option>
                            <% hesaplar.forEach(function(hesap) { %>
                                <option value="<%= hesap.hesap_id %>">
                                    <%= hesap.hesap_adi %> (<%= hesap.bakiye %> TL)
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-lg-2">
                        <select name="kategori_id" class="form-select" required>
                            <option value="" selected disabled>▼ Kategori</option>
                            <option value="1">🛒 Market</option>
                            <option value="2">🍔 Yemek</option>
                            <option value="3">🚗 Ulaşım</option>
                            <option value="4">💊 Sağlık</option>
                            <option value="5">🧾 Fatura</option>
                            <option value="6">👕 Giyim</option>
                            <option value="7">💻 Teknoloji</option>
                            <option value="8">📚 Eğitim</option>
                            <option value="9">🎮 Eğlence</option>
                            <option value="10">💼 Maaş</option>
                            <option value="11">🧑‍💻 Freelance</option>
                            <option value="12">📈 Yatırım</option>
                            <option value="13">🎓 Burs</option>
                            <option value="14">🎁 Hediye</option>
                            <option value="15">✨ Diğer</option>
                        </select>
                    </div>
                    <div class="col-lg-2">
                        <input type="text" name="aciklama" placeholder="Açıklama" class="form-control">
                    </div>
                    <div class="col-lg-2">
                        <input type="date" name="tarih" class="form-control" required>
                    </div>
                    <div class="col-lg-1">
                        <button class="submit-btn">Ekle</button>
                    </div>
                </div>
            </form>
        </div>

        <% if (typeof hata !== 'undefined' && hata) { %>
            <div style="
                margin-top: 15px;
                background: rgba(239, 68, 68, 0.1);
                border: 1px solid rgba(239, 68, 68, 0.3);
                color: #f87171;
                padding: 10px 14px;
                border-radius: 10px;
                font-size: 13px;
                font-family: Arial, sans-serif;
                display: flex;
                justify-content: space-between;
                align-items: center;
            " id="ejsHataKutusu">
                <span>⚠️ <%= hata %></span>
                <button onclick="document.getElementById('ejsHataKutusu').remove();" style="
                    background: none;
                    border: none;
                    color: #f87171;
                    font-size: 16px;
                    cursor: pointer;
                    font-weight: bold;
                    padding-left: 10px;
                ">×</button>
            </div>
        <% } %>

<script>
    
    const urlKontrol = new URLSearchParams(window.location.search);
    const gelenHata = urlKontrol.get('error');

    if (gelenHata) {
        document.getElementById('hataMetniAlani').innerText = '⚠️ ' + gelenHata;
        document.getElementById('islemHataKutusu').style.display = 'block';
    }

    function kapatHataKutusunu() {
        
        window.history.replaceState({}, document.title, window.location.pathname);
       
        document.getElementById('islemHataKutusu').style.display = 'none';
    }
</script>

        <div class="form-box mt-4">
            <h4 class="mb-3" style="color: white; font-weight: bold; display: flex; justify-content: space-between; align-items: center;">
                <span>💳 Kredi Kartı Borcu Ödeme</span>
                <span style="font-size: 14px; color: #f87171; background: rgba(248, 113, 113, 0.1); padding: 6px 12px; border-radius: 8px; font-weight: 500;">
                    <% 
                        // Giriş yapan kullanıcının kredi kartını bulup güncel borç durumunu çıkarıyoruz
                        let kartHesabi = hesaplar.find(h => h.hesap_adi.includes('Kredi Kartı'));
                        let guncelBorc = kartHesabi ? Math.abs(parseFloat(kartHesabi.bakiye || 0)) : 0;
                    %>
                    Güncel Kart Borcu: <%= guncelBorc.toFixed(2) %> TL
                </span>
            </h4>
        
            <form action="/kart-borcu-ode" method="POST">
                <div class="row g-3">
                    
                    <div class="col-lg-5">
                        <select name="kaynak_hesap_id" class="form-select" required>
                            <option value="" selected disabled>▼ Ödemenin Yapılacağı Banka Hesabı</option>
                            <% hesaplar.forEach(h => { %>
                                <% if(!h.hesap_adi.includes('Kredi Kartı') && !h.hesap_adi.includes('Nakit')) { %>
                                    <option value="<%= h.hesap_id %>">
                                        <%= h.hesap_adi %> (Mevcut: <%= h.bakiye %> TL)
                                    </option>
                                <% } %>
                            <% }) %>
                        </select>
                    </div>
        
                    <div class="col-lg-4">
                        <input type="number" step="0.01" min="0.01" max="<%= guncelBorc %>" name="tutar" id="kartBorcTutarInput" placeholder="Ödenecek Tutar" class="form-control" required>
                        <style>
                            #kartBorcTutarInput::placeholder {
                                color: #ffffff !important;
                                opacity: 1 !important;
                            }
                        </style>
                    </div>
        
                    <div class="col-lg-3">
                        <button type="submit" class="submit-btn" style="background: #3b82f6;">Borcu Öde</button>
                    </div>
        
                </div>
            </form>
        </div>

        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h2 class="fw-bold mb-1">İşlem Geçmişi</h2>
                <p class="text-secondary mb-0">Toplam <%= islemler.length %> hareket listeleniyor.</p>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                <form action="/islemler" method="GET" class="d-flex align-items-center gap-2">
                    <% if(typeof suankiFiltre !== 'undefined' && suankiFiltre !== 'hepsi') { %>
                        <input type="hidden" name="filtre" value="<%= suankiFiltre %>">
                    <% } %>
            
                    <select name="ay" class="form-select" onchange="this.form.submit()" style="background:#1e293b; border-radius:12px; width:150px; font-size:14px; color:white; border:1px solid rgba(255,255,255,0.1);">
                        <option value="hepsi" <%= suankiAy == 'hepsi' ? 'selected' : '' %>>▼ Tüm Aylar</option>
                        <% 
                            const tumAylar = ["Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık"];
                            for(let i = 1; i <= 12; i++) { 
                        %>
                            <option value="<%= i %>" <%= suankiAy == i ? 'selected' : '' %>><%= tumAylar[i-1] %></option>
                        <% } %>
                    </select>
            
                    <select name="kategori" class="form-select" onchange="this.form.submit()" style="background:#1e293b; border-radius:12px; width:180px; font-size:14px; color:white; border:1px solid rgba(255,255,255,0.1);">
                        <option value="">▼ Tüm Kategoriler</option>
                        <option value="1" <%= typeof suankiKategori !== 'undefined' && suankiKategori == 1 ? 'selected' : '' %>>🛒 Market</option>
                        <option value="2" <%= typeof suankiKategori !== 'undefined' && suankiKategori == 2 ? 'selected' : '' %>>🍔 Yemek</option>
                        <option value="3" <%= typeof suankiKategori !== 'undefined' && suankiKategori == 3 ? 'selected' : '' %>>🚗 Ulaşım</option>
                        <option value="4" <%= typeof suankiKategori !== 'undefined' && suankiKategori == 4 ? 'selected' : '' %>>💊 Sağlık</option>
                        <option value="5" <%= typeof suankiKategori !== 'undefined' && suankiKategori == 5 ? 'selected' : '' %>>🧾 Fatura</option>
                        <option value="6" <%= typeof suankiKategori !== 'undefined' && suankiKategori == 6 ? 'selected' : '' %>>👕 Giyim</option>
                        <option value="7" <%= typeof suankiKategori !== 'undefined' && suankiKategori == 7 ? 'selected' : '' %>>💻 Teknoloji</option>
                        <option value="8" <%= typeof suankiKategori !== 'undefined' && suankiKategori == 8 ? 'selected' : '' %>>📚 Eğitim</option>
                        <option value="9" <%= typeof suankiKategori !== 'undefined' && suankiKategori == 9 ? 'selected' : '' %>>🎮 Eğlence</option>
                        <option value="10" <%= typeof suankiKategori !== 'undefined' && suankiKategori == 10 ? 'selected' : '' %>>💼 Maaş</option>
                        <option value="11" <%= typeof suankiKategori !== 'undefined' && suankiKategori == 11 ? 'selected' : '' %>>🧑‍💻 Freelance</option>
                        <option value="12" <%= typeof suankiKategori !== 'undefined' && suankiKategori == 12 ? 'selected' : '' %>>📈 Yatırım</option>
                        <option value="13" <%= typeof suankiKategori !== 'undefined' && suankiKategori == 13 ? 'selected' : '' %>>🎓 Burs</option>
                        <option value="14" <%= typeof suankiKategori !== 'undefined' && suankiKategori == 14 ? 'selected' : '' %>>🎁 Hediye</option>
                        <option value="15" <%= typeof suankiKategori !== 'undefined' && suankiKategori == 15 ? 'selected' : '' %>>✨ Diğer</option>
                    </select>
                </form>
            
                <div class="p-1 d-flex gap-1" style="background:#111827; border-radius:14px; border:1px solid rgba(255,255,255,0.05);">
                    <a href="/islemler" class="filter-btn <%= !suankiFiltre || suankiFiltre === 'hepsi' ? 'active' : '' %>">Hepsi</a>
                    <a href="/islemler?filtre=gelir<%= suankiAy !== 'hepsi' ? '&ay='+suankiAy : '' %><%= suankiKategori ? '&kategori='+suankiKategori : '' %>" class="filter-btn <%= suankiFiltre === 'gelir' ? 'active' : '' %>">Gelirler</a>
                    <a href="/islemler?filtre=gider<%= suankiAy !== 'hepsi' ? '&ay='+suankiAy : '' %><%= suankiKategori ? '&kategori='+suankiKategori : '' %>" class="filter-btn <%= suankiFiltre === 'gider' ? 'active' : '' %>">Giderler</a>
                </div>
            </div>
        </div>

        <div class="table-box">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Kategori</th>
                        <th>Hesap</th>
                        <th>Açıklama</th>
                        <th>Tür</th>
                        <th>Tutar</th>
                        <th>Tarih</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(islemler.length > 0) { %>
                        <% islemler.forEach(function(islem){ %>
                            <tr>
                                <td><div class="kategori-badge"><%= islem.kategori_adi %></div></td>
                                <td><%= islem.hesap_adi %></td>
                                <td><%= islem.aciklama || '-' %></td>
                                <td>
                                    <span class="tur <%= islem.tur === 'gelir' ? 'gelir' : 'gider' %>">
                                        <%= islem.tur === 'gelir' ? '↑ Gelir' : '↓ Gider' %>
                                    </span>
                                </td>
                                <td class="<%= islem.tur === 'gelir' ? 'text-success' : 'text-danger' %> fw-bold">
                                    <%= islem.tur === 'gelir' ? '+' : '-' %><%= islem.tutar.toLocaleString('tr-TR') %> TL
                                </td>
                                <td class="text-secondary">
                                    <%= new Date(islem.tarih).toLocaleDateString('tr-TR') %>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <button class="action-btn" data-bs-toggle="modal" data-bs-target="#editModal<%= islem.islem_id %>">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <a href="/sil/<%= islem.islem_id %>" class="action-btn delete-btn" onclick="return confirm('Bu işlemi silmek istediğine emin misin?')">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" class="text-center text-secondary py-5">Aradığınız kriterlere uygun işlem bulunamadı.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <% islemler.forEach(function(islem){ %>
        <div class="modal fade" id="editModal<%= islem.islem_id %>" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header border-0 p-4 pb-0">
                        <h5 class="modal-title fw-bold" style="font-size: 24px;">İşlem Düzenle</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <form action="/guncelle/<%= islem.islem_id %>" method="POST">
                        <div class="modal-body p-4">
                            <input type="number" step="0.01" name="tutar" value="<%= islem.tutar %>" placeholder="Tutar" class="form-control mb-3" required>
                            
                            <select name="tur" class="form-select mb-3" required>
                                <option value="gelir" <%= islem.tur == 'gelir' ? 'selected' : '' %>>Gelir</option>
                                <option value="gider" <%= islem.tur == 'gider' ? 'selected' : '' %>>Gider</option>
                            </select>
                            <select name="hesap_id" class="form-select mb-3" required>
                                <% hesaplar.forEach(function(hesap) { %>
                                    <option value="<%= hesap.hesap_id %>" <%= islem.hesap_id == hesap.hesap_id ? 'selected' : '' %>>
                                        <%= hesap.hesap_adi %>
                                    </option>
                                <% }) %>
                            </select>

                            <select name="kategori_id" class="form-select mb-3" required>
                                <option value="1" <%= islem.kategori_id == 1 ? 'selected' : '' %>>🛒 Market</option>
                                <option value="2" <%= islem.kategori_id == 2 ? 'selected' : '' %>>🍔 Yemek</option>
                                <option value="3" <%= islem.kategori_id == 3 ? 'selected' : '' %>>🚗 Ulaşım</option>
                                <option value="4" <%= islem.kategori_id == 4 ? 'selected' : '' %>>💊 Sağlık</option>
                                <option value="5" <%= islem.kategori_id == 5 ? 'selected' : '' %>>🧾 Fatura</option>
                                <option value="6" <%= islem.kategori_id == 6 ? 'selected' : '' %>>👕 Giyim</option>
                                <option value="7" <%= islem.kategori_id == 7 ? 'selected' : '' %>>💻 Teknoloji</option>
                                <option value="8" <%= islem.kategori_id == 8 ? 'selected' : '' %>>📚 Eğitim</option>
                                <option value="9" <%= islem.kategori_id == 9 ? 'selected' : '' %>>🎮 Eğlence</option>
                                <option value="10" <%= islem.kategori_id == 10 ? 'selected' : '' %>>💼 Maaş</option>
                                <option value="11" <%= islem.kategori_id == 11 ? 'selected' : '' %>>🧑‍💻 Freelance</option>
                                <option value="12" <%= islem.kategori_id == 12 ? 'selected' : '' %>>📈 Yatırım</option>
                                <option value="13" <%= islem.kategori_id == 13 ? 'selected' : '' %>>🎓 Burs</option>
                                <option value="14" <%= islem.kategori_id == 14 ? 'selected' : '' %>>🎁 Hediye</option>
                                <option value="15" <%= islem.kategori_id == 15 ? 'selected' : '' %>>✨ Diğer</option>
                            </select>

                            <input type="text" name="aciklama" value="<%= islem.aciklama %>" placeholder="Açıklama" class="form-control mb-3">

                            <input type="date" name="tarih" value="<%= new Date(islem.tarih).toISOString().split('T')[0] %>" class="form-control" required>
                        </div>
                        <div class="modal-footer border-0 p-4 pt-0">
                            <button type="submit" class="submit-btn">Güncelle</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    <% }) %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>