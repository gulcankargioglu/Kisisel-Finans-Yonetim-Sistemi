<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Finova - Kayıt Ol</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #0f172a;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: Arial;
            overflow: hidden;
        }

        .register-box {
            width: 420px;
            background: #111827;
            padding: 40px;
            border-radius: 24px;
            box-shadow: 0 0 40px rgba(0, 0, 0, 0.4);
        }

        .logo {
            text-align: center;
            font-size: 38px;
            font-weight: bold;
            color: white;
            margin-bottom: 10px;
        }

        .subtitle {
            text-align: center;
            color: #94a3b8;
            margin-bottom: 35px;
        }

        .form-control {
            background: #1e293b !important;
            border: none !important;
            color: white !important;
            padding: 14px;
            border-radius: 12px;
        }

        .form-control::placeholder {
            color: #94a3b8 !important;
        }

        .btn-register {
            width: 100%;
            background: #10b981;
            border: none;
            padding: 14px;
            border-radius: 12px;
            color: white;
            font-weight: bold;
            margin-top: 10px;
            transition: 0.3s;
        }

        .btn-register:hover {
            background: #059669;
        }

        .login-link {
            text-align: center;
            margin-top: 25px;
            color: #94a3b8;
        }

        .login-link a {
            color: #10b981;
            text-decoration: none;
        }
    </style>
</head>

<body>

    <div class="register-box">
        <div class="logo">
            💰 Finova
        </div>

        <div class="subtitle">
            Yeni bir hesap oluştur
        </div>

        <form action="/register" method="POST">
            <div class="mb-3">
                <input type="text" 
                       name="ad" 
                       placeholder="Ad Soyad" 
                       class="form-control" 
                       required>
            </div>

            <div class="mb-3">
                <input type="email" 
                       name="email" 
                       placeholder="Email" 
                       class="form-control" 
                       required>
            </div>

            <div class="mb-3">
                <input type="password" 
                       name="sifre" 
                       placeholder="Şifre" 
                       class="form-control" 
                       required>
            </div>

            <button type="submit" class="btn-register">
                Kayıt Ol
            </button>
        </form>

        <div class="login-link">
            Zaten hesabın var mı? 
            <a href="/login">Giriş Yap</a>
        </div>
    </div>

</body>

</html>