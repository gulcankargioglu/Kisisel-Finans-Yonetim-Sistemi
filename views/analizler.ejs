<!DOCTYPE html>
<html lang="tr">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Finova Analizler</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>

        *{

            margin:0;
            padding:0;
            box-sizing:border-box;

        }

        body{

            background:#0f172a;
            color:white;
            font-family:Arial;

        }

        .sidebar{

            width:260px;
            height:100vh;

            background:#111827;

            position:fixed;

            left:0;
            top:0;

            padding:30px 20px;

            border-right:1px solid rgba(255,255,255,0.05);

        }

        .logo{

            font-size:34px;
            font-weight:bold;

            margin-bottom:50px;

        }

        .menu-item{

            display:flex;

            align-items:center;

            gap:12px;

            text-decoration:none;

            color:#cbd5e1;

            padding:16px;

            border-radius:16px;

            margin-bottom:10px;

            transition:0.3s;

        }

        .menu-item:hover{

            background:#1e293b;

            color:white;

        }

        .active-menu{

            background:#10b981;

            color:white;

        }


        .main{

            margin-left:260px;

            padding:35px;

        }

        .topbar{

            display:flex;

            justify-content:space-between;

            align-items:center;

            margin-bottom:35px;

        }

        .topbar h1{

            font-size:40px;

            font-weight:bold;

            margin-bottom:10px;

        }

        .topbar p{

            color:#94a3b8;

        }

        .month-select{

            background:#111827;

            border:none;

            color:white;

            padding:12px 18px;

            border-radius:14px;

            outline:none;

        }


        .cards{

            display:grid;

            grid-template-columns:repeat(4,1fr);

            gap:25px;

            margin-bottom:35px;

        }

        .card-box{

            background:#111827;

            padding:28px;

            border-radius:24px;

        }

        .card-title{

            color:#94a3b8;

            margin-bottom:12px;

        }

        .card-value{

            font-size:28px;

            font-weight:bold;

        }


        .chart-grid{

            display:grid;

            grid-template-columns:1fr 1fr;

            gap:25px;

            margin-bottom:35px;

        }

        .chart-box{

            background:#111827;

            padding:30px;

            border-radius:28px;

        }

        .chart-title{

            font-size:24px;

            font-weight:bold;

            margin-bottom:25px;

        }


        .analysis-box{

            background:#111827;

            padding:30px;

            border-radius:28px;

        }

        .analysis-text{

            color:#cbd5e1;

            line-height:1.8;

            font-size:16px;

        }

    </style>

</head>

<body>

    <div class="sidebar">

        <div class="logo">

            Finova

        </div>

        <a href="/dashboard"
           class="menu-item">

           <i class="bi bi-grid"></i>
           Dashboard

        </a>
        <a href="/islemler"
        class="menu-item">
     
        <i class="bi bi-cash-stack"></i>
        İşlemler
     
     </a>
     
     
        <a href="/analizler"
           class="menu-item active-menu">

           <i class="bi bi-pie-chart"></i>
           Analizler

        </a>

        <a href="/butceler"
        class="menu-item">
     
        <i class="bi bi-bullseye"></i>
        Bütçeler
     
     </a>

    </div>


    <div class="main">


        <div class="topbar">

            <div>

                <h1>

                    Finansal Analizler

                </h1>

                <p>

                    Finansal verilerinin detaylı analizi

                </p>

            </div>


            <form action="/analizler"
                  method="GET">

                <select name="ay"
                        class="month-select"
                        onchange="this.form.submit()">

                    <option value="1"
                    <%= ay == 1 ? 'selected' : '' %>>

                        Ocak

                    </option>

                    <option value="2"
                    <%= ay == 2 ? 'selected' : '' %>>

                        Şubat

                    </option>

                    <option value="3"
                    <%= ay == 3 ? 'selected' : '' %>>

                        Mart

                    </option>

                    <option value="4"
                    <%= ay == 4 ? 'selected' : '' %>>

                        Nisan

                    </option>

                    <option value="5"
                    <%= ay == 5 ? 'selected' : '' %>>

                        Mayıs

                    </option>

                    <option value="6"
                    <%= ay == 6 ? 'selected' : '' %>>

                        Haziran

                    </option>

                    <option value="7"
                    <%= ay == 7 ? 'selected' : '' %>>

                        Temmuz

                    </option>

                    <option value="8"
                    <%= ay == 8 ? 'selected' : '' %>>

                        Ağustos

                    </option>

                    <option value="9"
                    <%= ay == 9 ? 'selected' : '' %>>

                        Eylül

                    </option>

                    <option value="10"
                    <%= ay == 10 ? 'selected' : '' %>>

                        Ekim

                    </option>

                    <option value="11"
                    <%= ay == 11 ? 'selected' : '' %>>

                        Kasım

                    </option>

                    <option value="12"
                    <%= ay == 12 ? 'selected' : '' %>>

                        Aralık

                    </option>

                </select>

            </form>

        </div>


        <div class="cards">

            <div class="card-box">

                <div class="card-title">

                    Toplam Gelir

                </div>

                <div class="card-value text-success">

                    +<%= toplamGelir %> TL

                </div>

            </div>

            <div class="card-box">

                <div class="card-title">

                    Toplam Gider

                </div>

                <div class="card-value text-danger">

                    -<%= toplamGider %> TL

                </div>

            </div>

            <div class="card-box">

                <div class="card-title">

                    Tasarruf Oranı

                </div>

                <div class="card-value text-warning">

                    %<%= tasarruf %>

                </div>

            </div>

            <div class="card-box">

                <div class="card-title">

                    En Çok Harcama

                </div>

                <div class="card-value text-primary">

                    <%= enCokKategori %>

                </div>

            </div>

        </div>


        <div class="chart-grid">


            <div class="chart-box">

                <div class="chart-title">

                    Kategori Harcama Analizi

                </div>

                <canvas id="kategoriChart"></canvas>

            </div>


            <div class="chart-box">

                <div class="chart-title">

                    Hesap Kullanımı

                </div>

                <canvas id="hesapChart"></canvas>

            </div>

        </div>

        <div class="analysis-box">

            <div class="chart-title">

                Finansal Yorum

            </div>

            <div class="analysis-text">

                Bu ay en fazla harcama
                <b>

                    <%= enCokKategori %>

                </b>

                kategorisinde yapılmış.

                Toplam giderin
                <b>

                    <%= toplamGider %> TL

                </b>

                seviyesinde.

                Tasarruf oranın ise
                <b>

                    %<%= tasarruf %>

                </b>

                olarak hesaplandı.

            </div>

        </div>

    </div>


    <script>


        new Chart(

            document.getElementById("kategoriChart"),

            {

                type:"pie",

                data:{

                    labels: JSON.parse('<%- kategoriAdlari %>'),

                    datasets:[{

                        data: JSON.parse('<%- kategoriToplamlari %>'),

                        backgroundColor:[

                            '#ef4444',
                            '#f59e0b',
                            '#10b981',
                            '#3b82f6',
                            '#8b5cf6',
                            '#ec4899'

                        ],

                        borderWidth:0

                    }]

                },

                options:{

                    plugins:{

                        legend:{

                            labels:{

                                color:"white",

                                font:{

                                    size:14

                                }

                            }

                        }

                    }

                }

            }

        );


        new Chart(

            document.getElementById("hesapChart"),

            {

                type:"bar",

                data:{

                    labels: JSON.parse('<%- hesapAdlari %>'),

                    datasets:[{

                        data: JSON.parse('<%- hesapKullanimlari %>'),

                        backgroundColor:[

                            '#10b981',
                            '#3b82f6',
                            '#f59e0b'

                        ],

                        borderRadius:12

                    }]

                },

                options:{

                    plugins:{

                        legend:{

                            display:false

                        }

                    },

                    scales:{

                        y:{

                            ticks:{

                                color:"white"

                            },

                            grid:{

                                color:"rgba(255,255,255,0.05)"

                            }

                        },

                        x:{

                            ticks:{

                                color:"white"

                            },

                            grid:{

                                display:false

                            }

                        }

                    }

                }

            }

        );

    </script>

</body>

</html>